                "role": "engineer"
            }
        ]
    },
    "chatbot": {
        "mini_agent_enable": true,
        "agent_use_llm": true,
        "llm_enable": true,
        "fallback_to_rules": true,
        "ollama_url": "http://127.0.0.1:11434/api/generate",
        "model": "qwen2.5:7b-instruct",
        "timeout_sec": 8,
        "temperature": 0.2,
        "num_predict": 260,
        "providers": [
            {
                "name": "anthropic-api",
                "type": "anthropic",
                "model": "claude-sonnet-5",
                "api_key_env": "ANTHROPIC_API_KEY",
                "timeout_sec": 30,
                "max_tokens": 260,
                "enabled": true
            },
            {
                "name": "openai-api",
                "type": "openai",
                "model": "gpt-4o-mini",
                "enabled": false,
                "api_key_env": "OPENAI_API_KEY",
                "timeout_sec": 30,
                "max_tokens": 260
            },
            {
                "name": "qwen-local",
                "type": "ollama",
                "model": "qwen2.5:7b-instruct",
                "timeout_sec": 8
            },
            {
                "name": "llama-local",
                "type": "ollama",
                "model": "llama3.1:8b",
                "timeout_sec": 8
            },
            {
                "name": "gemma-local",
                "type": "ollama",
                "model": "gemma2:9b",
                "timeout_sec": 8
            }
        ]
    },
